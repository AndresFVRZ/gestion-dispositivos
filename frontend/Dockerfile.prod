# Frontend - imagen de PRODUCCIÓN (build de Vite servido por nginx)

# --- 1. Build ---
FROM node:22-bookworm-slim AS build
RUN corepack enable
WORKDIR /app
COPY package.json ./
RUN pnpm install
COPY . .
# El bundle llamará a la API por ruta relativa; nginx la reenvía al backend.
ARG VITE_API_URL=/api
ENV VITE_API_URL=$VITE_API_URL
RUN pnpm build

# --- 2. Servir estáticos + proxy ---
FROM nginx:1.27-alpine AS serve
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
