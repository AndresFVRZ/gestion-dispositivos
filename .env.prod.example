# Plantilla para el despliegue en producción con docker-compose.prod.yml
# Copiar a  .env.prod  y rellenar con valores reales.  NUNCA subir .env.prod a git.

# --- Base de datos ---
DB_ROOT_PASSWORD=pon-aqui-una-contrasena-fuerte
DB_NAME=lucoa

# --- App / seguridad ---
SECRET_KEY=genera-una-clave-larga-y-aleatoria-para-firmar-los-JWT
PORT=5080

# --- Puerto público del sitio (lo expone nginx) ---
WEB_PORT=8090

# --- URLs públicas (para enlaces de correo y src de logos en emails) ---
# Local:    http://localhost:8090
# Servidor: https://tu-dominio.com
APP_URL=http://localhost:8090
APP_URL_BACKEND=http://localhost:8090

# --- Correo saliente (SMTP) ---
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_USER=usuario@dominio.com
SMTP_PASS=
SMTP_FROM=usuario@dominio.com
