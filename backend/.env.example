# Servidor
PORT=5080
SECRET_KEY=cambia-esta-clave

# Base de datos - MariaDB / MySQL (XAMPP)
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
DB_NAME=lucoa

# Email (SMTP)
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_USER=usuario@dominio.com
SMTP_PASS=
