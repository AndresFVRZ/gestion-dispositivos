# URLs de la app (puertos propios de este proyecto: back 5080 / front 5180)
APP_URL=http://localhost:5180
APP_URL_BACKEND=http://localhost:5080
# Orígenes permitidos por CORS, separados por coma (opcional; por defecto APP_URL)
# CORS_ORIGINS=
